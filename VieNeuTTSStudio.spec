    pathex=[],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=['torch', 'gradio', 'librosa', 'pytest', 'tkinter'],
    noarchive=False,
    optimize=0,
